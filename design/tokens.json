{
  "$comment": "Mirrors react_native_app/src/tokens.ts. Aligned to the Atlas production credit-card screen.",
  "color": {
    "ink":          "#16161D",
    "ink2":         "#6B6B76",
    "ink3":         "#9A9AA8",
    "paper":        "#F3F3F8",
    "surface":      "#FFFFFF",
    "rule":         "#ECECF2",
    "accent":       "#5B4CFF",
    "accentInk":    "#FFFFFF",
    "accentSoft":   "#EEEAFF",
    "navy":         "#1A1464",
    "positive":     "#1F8A4C",
    "warning":      "#8A5B06",
    "critical":     "#C0392B",
    "criticalSoft": "#F8E8E6"
  },
  "space": { "s1": 4, "s2": 8, "s3": 12, "s4": 16, "s5": 24, "s6": 32, "s7": 48 },
  "radius": 20,
  "radiusButton": 24,
  "type": {
    "display":   { "size": 36, "weight": 700, "lineHeight": 1.1, "tracking": -0.6 },
    "title":     { "size": 28, "weight": 700, "lineHeight": 1.2, "tracking": -0.4 },
    "heading":   { "size": 16, "weight": 600, "lineHeight": 1.3 },
    "body":      { "size": 15, "weight": 400, "lineHeight": 1.45 },
    "small":     { "size": 13, "weight": 400, "lineHeight": 1.4 },
    "label":     { "size": 13, "weight": 500, "lineHeight": 1.3 },
    "numeric":   { "size": 16, "weight": 500, "lineHeight": 1.4, "tabularFigures": true }
  },
  "font": {
    "$comment": "The production app uses a licensed typeface that is not in this repo. Use the platform default."
  }
}
